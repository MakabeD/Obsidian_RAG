{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "ModelPath": "model/model.onnx",
    "VocabPath": "model/vocab.txt",
    "MaxTokenLength": 512,

    "ChromaBaseUrl": "http://127.0.0.1:8000",
    "ChromaTenant": "default_tenant",
    "ChromaDatabase": "default_database",
    "CollectionName": "vault_collection",

    "ChunkThreshold": 600,
    "DefaultTopK": 5,
    "MaxTopK": 50,

    "MaxUploadBytes": 26214400,
    "MaxZipEntryBytes": 5242880,
    "MaxZipTotalUncompressedBytes": 209715200,
    "MaxZipEntries": 5000,
    "MaxZipCompressionRatio": 100,

    "SessionTtlMinutes": 10,
    "SweepIntervalSeconds": 30,
    "HealthCheckTimeoutMs": 2000
  }
}
